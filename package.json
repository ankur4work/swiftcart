    "next": "14.2.35",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.20.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@shopify/cli": "^4.7.0",
    "@types/node": "^22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "typescript": "5.6.3"
