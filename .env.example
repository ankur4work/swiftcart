# SwiftCart environment.
# Copy to .env for local development. In production these are set in Coolify.

NODE_ENV=development
LOG_LEVEL=debug

# --- Shopify app credentials (Partner dashboard → App setup) -----------------
# Fill these in once the app exists in the dashboard.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://swiftcart.live

# Empty on purpose — SwiftCart requests no Admin API scopes. Its only write is
# an app-data metafield on its own installation, which needs none. Leave this
# unset rather than inventing a scope; note `write_metafields` is NOT a real
# scope and Shopify rejects it at deploy time.
SHOPIFY_SCOPES=

# App handle — must match `handle` in shopify.app.toml. Used to build the
# Shopify-hosted plan selection URL. Handles are globally unique and plain
# "swiftcart" was already taken.
SHOPIFY_APP_HANDLE=swiftcart-live

# --- Database ----------------------------------------------------------------
# Local: matches docker/docker-compose.yml (note the 5433 host port, chosen so
# it doesn't collide with a Postgres you may already run on 5432).
DATABASE_URL=postgresql://swiftcart:swiftcart@localhost:5433/swiftcart

# --- Secrets -----------------------------------------------------------------
# 32 bytes of hex. Encrypts stored Shopify access tokens.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=

# --- Pricing display ---------------------------------------------------------
# The CHARGE is defined in the Partner dashboard, not here — Shopify owns
# billing. These only render the paywall shown before a merchant has a
# subscription to read a real price from. Keep them in sync with the dashboard.
#
# Amount and currency are kept separate, and the symbol is added in code. A
# literal "$30" here would be swallowed by shell / docker-compose variable
# interpolation on its way into the container.
SWIFTCART_DISPLAY_AMOUNT=30
SWIFTCART_DISPLAY_CURRENCY=USD
SWIFTCART_DISPLAY_INTERVAL=month
SWIFTCART_PLAN_NAME=SwiftCart Pro

# --- Contact -----------------------------------------------------------------
SUPPORT_EMAIL=support@swiftcart.live
PRIVACY_CONTACT_EMAIL=privacy@swiftcart.live
COMPANY_ADDRESS=SwiftCart
